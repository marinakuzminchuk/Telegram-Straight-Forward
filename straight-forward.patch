+    func forwardFromAttachment(captionText: NSAttributedString, mediaPickerContext: AttachmentMediaPickerContext?, dismissAttachment: @escaping () -> Void) {
+        let filter: ChatListNodePeersFilter = [.onlyWriteable, .excludeDisabled, .doNotSearchMessages]
+        var excludedPeerIds = Set<EnginePeer.Id>()
+        if let currentPeerId = self.chatLocation.peerId {
+            excludedPeerIds.insert(currentPeerId)
+        }
+        let controller = self.context.sharedContext.makePeerSelectionController(PeerSelectionControllerParams(
+            context: self.context,
+            updatedPresentationData: self.updatedPresentationData,
+            filter: filter,
+            hasFilters: false,
+            title: "Forward",
+            multipleSelection: true,
+            selectForumThreads: false,
+            immediatelyActivateMultipleSelection: true,
+            excludedPeerIds: excludedPeerIds,
+            initialInputText: captionText
+        ))
+
+        let context = self.context
+
+        controller.multiplePeersSelected = { [weak self, weak controller] peers, _, editedText, mode, _, _ in
+            guard let strongSelf = self, let strongController = controller else { return }
+            guard !peers.isEmpty else { return }
+            strongController.dismiss()
+
+            let sendMode: AttachmentMediaPickerSendMode = mode == .silent ? .silently : .generic
+
+            if let mediaPickerContext = mediaPickerContext {
+                mediaPickerContext.setCaption(editedText)
+                mediaPickerContext.sendToMultiplePeers(peers, mode: sendMode, context: context, completion: {
+                    dismissAttachment()
+                })
+            } else {
+                var baseMessages: [EnqueueMessage] = []
+                let trimmedText = trimChatInputText(editedText)
+                for text in breakChatInputText(trimmedText) {
+                    if text.length != 0 {
+                        var attributes: [EngineMessage.Attribute] = []
+                        let entities = generateTextEntities(text.string, enabledTypes: .all, currentEntities: generateChatInputTextEntities(text, maxAnimatedEmojisInText: 0))
+                        if !entities.isEmpty { attributes.append(TextEntitiesMessageAttribute(entities: entities)) }
+                        baseMessages.append(.message(text: text.string, attributes: attributes, inlineStickers: [:], mediaReference: nil, threadId: nil, replyToMessageId: nil, replyToStoryId: nil, localGroupingKey: nil, correlationId: nil, bubbleUpEmojiOrStickersets: []))
+                    }
+                }
+                let isSilent = mode == .silent
+                let messages: [EnqueueMessage] = isSilent ? baseMessages.map { message in
+                    message.withUpdatedAttributes { attrs in
+                        var attrs = attrs
+                        attrs.removeAll(where: { $0 is NotificationInfoMessageAttribute })
+                        attrs.append(NotificationInfoMessageAttribute(flags: .muted))
+                        return attrs
+                    }
+                } : baseMessages
+                for peer in peers {
+                    let _ = (enqueueMessages(account: context.account, peerId: peer.id, messages: messages) |> deliverOnMainQueue).startStandalone()
+                }
+                dismissAttachment()
+            }
+
+            let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+            let recipientCount = peers.count
+            let text: String
+            if recipientCount == 1, let peer = peers.first {
+                var peerName = peer.id == context.account.peerId
+                    ? presentationData.strings.DialogList_SavedMessages
+                    : peer.displayTitle(strings: presentationData.strings, displayOrder: presentationData.nameDisplayOrder)
+                peerName = peerName.replacingOccurrences(of: "**", with: "")
+                text = presentationData.strings.Conversation_ForwardTooltip_Chat_One(peerName).string
+            } else if recipientCount > 1, let firstPeer = peers.first {
+                var firstName = firstPeer.displayTitle(strings: presentationData.strings, displayOrder: presentationData.nameDisplayOrder)
+                firstName = firstName.replacingOccurrences(of: "**", with: "")
+                text = presentationData.strings.Conversation_ForwardTooltip_ManyChats_One(firstName, "\(recipientCount - 1)").string
+            } else {
+                text = ""
+            }
+            if !text.isEmpty {
+                strongSelf.present(
+                    UndoOverlayController(
+                        presentationData: presentationData,
+                        content: .forward(savedMessages: false, text: text),
+                        elevatedLayout: false,
+                        animateInAsReplacement: true,
+                        action: { _ in false }
+                    ),
+                    in: .current
+                )
+            }
+        }
+
+        self.chatDisplayNode.dismissInput()
+        self.effectiveNavigationController?.pushViewController(controller)
+    }
+}
