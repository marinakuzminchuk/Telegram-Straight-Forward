+    func sendToMultiplePeers(_ peers: [EnginePeer], mode: AttachmentMediaPickerSendMode, context: AccountContext, completion: @escaping () -> Void) {
+        guard let controller = self.controller else { completion(); return }
+        let signals: [Any]
+        switch controller.subject {
+        case .assets:
+            signals = TGMediaAssetsController.resultSignals(for: controller.interaction?.selectionState, editingContext: controller.interaction?.editingState, intent: TGMediaAssetsControllerSendMediaIntent, currentItem: nil, storeAssets: true, convertToJpeg: false, descriptionGenerator: legacyAssetPickerItemGenerator(), saveEditedPhotos: controller.saveEditedPhotos) ?? []
+        case .media:
+            signals = TGMediaAssetsController.pasteboardResultSignals(for: controller.interaction?.selectionState, editingContext: controller.interaction?.editingState, intent: TGMediaAssetsControllerSendMediaIntent, currentItem: nil, descriptionGenerator: legacyAssetPickerItemGenerator()) ?? []
+        }
+        guard !signals.isEmpty else { completion(); return }
+        let silently = mode == .silently
+        let _ = (legacyAssetPickerEnqueueMessages(context: context, account: context.account, signals: signals)
+        |> deliverOnMainQueue).startStandalone(next: { items in
+            var messages = items.map { $0.message }
+            if silently {
+                messages = messages.map { message in
+                    message.withUpdatedAttributes { attrs in
+                        var attrs = attrs
+                        attrs.removeAll { $0 is NotificationInfoMessageAttribute }
+                        attrs.append(NotificationInfoMessageAttribute(flags: .muted))
+                        return attrs
+                    }
+                }
+            }
+            for peer in peers {
+                let _ = enqueueMessages(account: context.account, peerId: peer.id, messages: messages).startStandalone()
+            }
+            completion()
+        })
+    }
+
     func mainButtonAction() {
         self.controller?.mainButtonPressed()
     }
-    
+
