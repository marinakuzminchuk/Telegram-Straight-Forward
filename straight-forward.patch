From b2377ae378dabf73b97732973e9bf4663bedc11e Mon Sep 17 00:00:00 2001
From: Marina Kuzminchuk <marina.a.kuzminchuk@gmail.com>
Date: Sun, 1 Nov 2026 16:21:04 +0100
Subject: [PATCH 4/5] fix: give each peer its own album grouping keys in
 straight-forward

sendToMultiplePeers enqueued the same messages, with the same
localGroupingKey, for every selected peer. PendingMessageManager collects
an album by grouping key alone, across peers, and sends the whole group to
the first message's peer, so a two-photo album forwarded to Saved Messages
and a contact arrived in Saved Messages twice and not at the contact.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Sources/MediaPickerScreen.swift           | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/submodules/MediaPickerUI/Sources/MediaPickerScreen.swift b/submodules/MediaPickerUI/Sources/MediaPickerScreen.swift
index 1d87e8665a..5a269d0610 100644
--- a/submodules/MediaPickerUI/Sources/MediaPickerScreen.swift
+++ b/submodules/MediaPickerUI/Sources/MediaPickerScreen.swift
@@ -3515,7 +3515,24 @@ final class MediaPickerContext: AttachmentMediaPickerContext {
                 }
             }
             for peer in peers {
-                let _ = enqueueMessages(account: context.account, peerId: peer.id, messages: messages).startStandalone()
+                // PendingMessageManager collects an album by grouping key alone, across peers, and
+                // sends it to the first message's peer. Sharing keys between peers would merge every
+                // peer's copy of the album into one request to a single chat, so remap them per peer.
+                var groupingKeys: [Int64: Int64] = [:]
+                let peerMessages = messages.map { message in
+                    message.withUpdatedGroupingKey { groupingKey in
+                        guard let groupingKey else {
+                            return nil
+                        }
+                        if let mapped = groupingKeys[groupingKey] {
+                            return mapped
+                        }
+                        let mapped = Int64.random(in: Int64.min ... Int64.max)
+                        groupingKeys[groupingKey] = mapped
+                        return mapped
+                    }
+                }
+                let _ = enqueueMessages(account: context.account, peerId: peer.id, messages: peerMessages).startStandalone()
             }
             completion()
         })
-- 
