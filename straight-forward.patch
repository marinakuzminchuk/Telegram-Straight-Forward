From 7d5e8feb0ec79b633e7bdd77f4c44b0d184b8bea Mon Sep 17 00:00:00 2001
From: Marina Kuzminchuk <marina.a.kuzminchuk@gmail.com>
Date: Sun, 1 Nov 2026 16:21:05 +0100
Subject: [PATCH 5/5] fix: straight-forward caption, input and sender-name
 handling

- Forwarding from attachments applies the peer picker's caption only when
  it was edited there. A set caption overrides every item's own caption,
  so forwarding from the full-screen gallery (which starts with an empty
  caption) erased captions typed on the photos.
- Clear the chat input after forwarding from attachments, as a normal
  media send does; its text was carried into the caption and sent.
- Hide "Forwarded from" only when every message was authored by the
  account and is not itself a forward (the old check compared the chat,
  so it only worked from Saved Messages), and respect sender visibility
  chosen explicitly in the forward options.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Sources/ChatControllerBroadcastMessage.swift    | 10 +++++++++-
 .../Sources/ChatControllerForwardMessages.swift     | 13 +++++++++----
 2 files changed, 18 insertions(+), 5 deletions(-)

diff --git a/submodules/TelegramUI/Sources/ChatControllerBroadcastMessage.swift b/submodules/TelegramUI/Sources/ChatControllerBroadcastMessage.swift
index 47be7d8951..0ce6ad63c2 100644
--- a/submodules/TelegramUI/Sources/ChatControllerBroadcastMessage.swift
+++ b/submodules/TelegramUI/Sources/ChatControllerBroadcastMessage.swift
@@ -212,10 +212,18 @@ extension ChatControllerImpl {
             guard !peers.isEmpty else { return }
             strongController.dismiss()
 
+            // The chat's input text was carried into the attachment caption, so it has been sent now.
+            strongSelf.clearInputText()
+
             let sendMode: AttachmentMediaPickerSendMode = mode == .silent ? .silently : .generic
 
             if let mediaPickerContext = mediaPickerContext {
-                mediaPickerContext.setCaption(editedText)
+                // A set caption overrides every item's own caption, so only apply it when the user
+                // edited it in the peer picker; otherwise per-item captions (e.g. typed in the
+                // full-screen gallery, which starts the forward with an empty caption) are kept.
+                if !editedText.isEqual(to: captionText) {
+                    mediaPickerContext.setCaption(editedText)
+                }
                 mediaPickerContext.sendToMultiplePeers(peers, mode: sendMode, context: context, completion: {
                     dismissAttachment()
                 })
